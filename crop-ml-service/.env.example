# Copy this file to .env and fill in your real values.
# .env is never committed to version control.

# Get a free key from https://aistudio.google.com/apikey
# Powers THREE features: reading uploaded soil reports, generating
# crop growing guides, and generating disease treatment plans.
# Without it, /predict and /disease/predict still work fine — only
# the Gemini-backed endpoints return a 503 with a clear message.
GOOGLE_API_KEY=
# Change only if Google deprecates this model name — see
# https://ai.google.dev/gemini-api/docs/models for current options.
GEMINI_MODEL=gemini-2.5-flash

# Must exactly match the origin your Vite dev server runs on
# (protocol + host + port), or the browser blocks every request.
FRONTEND_ORIGIN=http://localhost:5173

PORT=8001
